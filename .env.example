# PostgreSQL for local development. Replace with a managed PostgreSQL URL in production.
DATABASE_URL=postgresql://bits:bits@localhost:5433/bits_kurnool
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
PORT=3001
WEB_ORIGIN=http://localhost:5173
ATTENDANCE_THRESHOLD=75
NODE_ENV=development

# Optional integrations. Leave blank to use safe mock mode.
SMS_PROVIDER=mock
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=
REDIS_URL=
PAYMENT_GATEWAY_KEY=
