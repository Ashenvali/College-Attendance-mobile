# PostgreSQL for local development. Replace with a managed PostgreSQL URL in production.
DATABASE_URL=postgresql://bits:bits@localhost:5432/bits_kurnool
BITSKNL_AUTH_SIGNING_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
PORT=3001
WEB_ORIGIN=http://localhost:5173
ATTENDANCE_THRESHOLD=75
NODE_ENV=development

# Number of reverse-proxy hops in front of the API (so rate limits see the real client IP). Leave unset for none.
TRUST_PROXY=
# Attendance rules
ATTENDANCE_EDIT_WINDOW_DAYS=7
# Absent-student parent SMS administrator control: off | manual (default) | auto
ABSENT_SMS_MODE=manual
# DEVELOPMENT DATABASES ONLY. Never set against production; `npm run db:disable-demo` deactivates demo accounts.
ALLOW_DEMO_SEED=true

# SMS: leave SMS_PROVIDER=mock (default) for test mode - nothing is transmitted.
# Live providers (server-side only, never in the mobile app): msg91 | http
SMS_PROVIDER=mock
SMS_SENDER_ID=
# MSG91 (SMS_PROVIDER=msg91). Template variables must match the DLT template: student_name, roll_number, department, date
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
SMS_WEBHOOK_SECRET=
# Generic gateway (SMS_PROVIDER=http)
SMS_API_URL=
SMS_API_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=
REDIS_URL=
PAYMENT_GATEWAY_KEY=
