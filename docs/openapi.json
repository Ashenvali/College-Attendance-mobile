{
  "openapi": "3.0.3",
  "info": { "title": "BITS Kurnool College Management API", "version": "0.1.0", "description": "REST API for the BITS Kurnool management and student communication system. Demo identities and data are fictional." },
  "servers": [{ "url": "/api" }],
  "components": { "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } }, "schemas": { "Envelope": { "type": "object", "properties": { "success": { "type": "boolean" }, "message": { "type": "string" }, "data": {} } } } },
  "paths": {
    "/auth/login": { "post": { "summary": "Create a JWT session", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["identifier", "password"], "properties": { "identifier": { "type": "string" }, "password": { "type": "string", "format": "password" } } } } } }, "responses": { "200": { "description": "Authenticated" }, "401": { "description": "Invalid credentials" } } } },
    "/auth/me": { "get": { "summary": "Current session profile", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Session and role profile" } } } },
    "/dashboard": { "get": { "summary": "Role-specific dashboard data", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Dashboard" } } } },
    "/attendance/register/classes": { "get": { "summary": "Assigned faculty classes", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Assigned subjects and sections" }, "403": { "description": "Forbidden" } } } },
    "/attendance/register": { "get": { "summary": "Load a date-specific student register", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "subjectId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "sectionId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "date", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } }], "responses": { "200": { "description": "Roster with existing attendance and subject percentages" } } } },
    "/attendance": { "post": { "summary": "Create or update attendance transactionally", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Saved; percentages recalculated and low-attendance alerts evaluated" }, "403": { "description": "Class assignment denied" } } } },
    "/attendance/me": { "get": { "summary": "Student's recorded attendance", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Subject-level totals and attendance history" } } } },
    "/attendance/analytics": { "get": { "summary": "HOD and institution attendance analytics", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Year, section, subject and low-attendance analytics" } } },
    "/notices": { "get": { "summary": "List notices within the caller's audience scope", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Visible notices" } } }, "post": { "summary": "Publish a role-scoped notice and in-app notifications", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Notice published" } } } },
    "/notifications": { "get": { "summary": "List personal notifications", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "User notifications" } } } },
    "/sms/campaigns": { "post": { "summary": "Create an SMS campaign (safe mock mode by default)", "security": [{ "bearerAuth": [] }], "responses": { "201": { "description": "Campaign created" } } } }
  }
}
