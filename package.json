{
  "name": "bits-kurnool-college-management",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/api", "apps/web", "apps/mobile"],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite apps/web --config apps/web/vite.config.ts --host 0.0.0.0",
    "build": "npm run build --workspace @bitsknl/api && npm run build --workspace @bitsknl/web",
    "db:migrate": "tsx apps/api/src/db/migrate.ts",
    "db:seed": "tsx apps/api/src/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "typecheck": "npm run typecheck --workspace @bitsknl/api && npm run typecheck --workspace @bitsknl/web",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "test:smoke": "node scripts/smoke-test.mjs && node scripts/module-smoke-test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  }
}
